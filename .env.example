# Optional. Copy to `.env` (never commit .env) and fill in once the real values exist.
# These are PUBLIC values baked into the static build — never put secrets in VITE_* variables.

# Your GitHub repository URL (defaults to a clearly-marked placeholder)
VITE_GITHUB_URL=https://github.com/your-org/sakura

# Public contact address shown in the footer (defaults to a placeholder)
VITE_CONTACT_EMAIL=hello@sakura.example
